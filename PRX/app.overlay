#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&i2s0 {
    status = "okay";
    pinctrl-0 = <&i2s0_default>;
    pinctrl-names = "default";
};

&pinctrl {
    i2s0_default: i2s0_default {
        group1 {
            psels = <
                NRF_PSEL(I2S_SCK_M, 0, 6)   /* BCLK P0.06 */
                NRF_PSEL(I2S_LRCK_M, 0, 8)  /* LRC  P0.08 */
                NRF_PSEL(I2S_SDOUT, 0, 17)  /* DIN  P0.17 */
            >;
        };
    };
};